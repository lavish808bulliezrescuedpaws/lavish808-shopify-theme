<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{% if request.page_type == 'index' %}Lavish 808 Bulliez Rescued Paws{% elsif product %}{{ product.title }} &middot; Lavish 808 Bulliez Rescued Paws{% elsif collection %}{{ collection.title }} &middot; Lavish 808 Bulliez Rescued Paws{% else %}{{ page_title }} &middot; Lavish 808 Bulliez Rescued Paws{% endif %}</title>
    {% capture lavish_meta_description %}{% if page_description != blank %}{{ page_description | strip_html }}{% elsif product %}{{ product.description | strip_html | truncate: 155 }}{% elsif collection.description != blank %}{{ collection.description | strip_html | truncate: 155 }}{% elsif request.page_type == 'index' %}Shop rescue-inspired apparel from Lavish808Bulliez Rescued Paws. Net merchandise proceeds support veterinary care, food, transportation, rehabilitation, and rehoming.{% else %}Lavish808Bulliez Rescued Paws is rooted in aloha and dedicated to rescue, rehabilitation, and loving forever homes.{% endif %}{% endcapture %}
    <meta name="description" content="{{ lavish_meta_description | strip | escape }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&amp;family=Figtree:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'catalog.css' | asset_url | stylesheet_tag }}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Lavish808Bulliez Rescued Paws",
        "url": {{ shop.url | json }},
        "description": "Rooted in aloha and dedicated to rescue, rehabilitation, and loving forever homes."
      }
    </script>
    {% if product %}
      {% assign lavish_available_variants = product.variants | where: 'available', true %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Product",
          "name": {{ product.title | json }},
          "description": {{ product.description | strip_html | json }},
          "image": [{% if product.featured_image %}{{ product.featured_image | image_url: width: 1600 | prepend: 'https:' | json }}{% endif %}],
          "brand": {"@type": "Brand", "name": "Lavish808Bulliez Rescued Paws"},
          "offers": [
            {% for variant in lavish_available_variants %}
              {
                "@type": "Offer",
                "url": {{ shop.url | append: product.url | append: '?variant=' | append: variant.id | json }},
                "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
                "price": {{ variant.price | money_without_currency | json }},
                "availability": "https://schema.org/InStock",
                "itemCondition": "https://schema.org/NewCondition"{% if variant.sku != blank %},
                "sku": {{ variant.sku | json }}{% endif %}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }
      </script>
    {% endif %}
  </head>
  <body>
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% sections 'header-group' %}
    <main id="MainContent">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
  </body>
</html>
