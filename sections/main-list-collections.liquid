<section class="section shell"><header class="page-hero"><p class="eyebrow">Shop with purpose</p><h1 class="page-title">Collections</h1></header><div class="list-collections">{% for collection in collections %}<article class="catalog-card"><a class="catalog-card__image" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</a><div class="catalog-card__body"><h2><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h2><p class="rte">{{ collection.description | strip_html | truncate: 130 }}</p></div></article>{% endfor %}</div></section>
{% schema %}{"name":"Collection list","settings":[]}{% endschema %}
