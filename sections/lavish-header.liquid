<div class="site-header-wrap">
  <header class="site-header shell">
    <a class="brand" href="{{ routes.root_url }}"><span>Lavish 808 Bulliez</span><small>RESCUED PAWS · SAVING SINCE 2024</small></a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="{{ routes.root_url }}#shop">Shop</a>
      <a href="{{ routes.root_url }}#spike">Team Spike</a>
      <a href="{{ routes.root_url }}#stories">Stories</a>
      <a href="{{ routes.root_url }}#mission">Our Mission</a>
      <a href="{{ routes.search_url }}">Search</a>
      <a href="https://lavish808bulliezrescuedpaws.org/">Rescue Site</a>
      <a href="{{ routes.cart_url }}">Cart · {{ cart.item_count }}</a>
