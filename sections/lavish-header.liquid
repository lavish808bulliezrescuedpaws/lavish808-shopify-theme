      <a class="mobile-cart" href="{{ routes.cart_url }}" aria-label="Cart with {{ cart.item_count }} items">Cart &middot; {{ cart.item_count }}</a>
      <a class="donate-link" href="https://www.zeffy.com/en-US/donation-form/donate-to-change-lives-17387">Donate</a>
    </div>
  </header>
</div>
