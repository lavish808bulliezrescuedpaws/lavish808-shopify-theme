<section class="section shell">
  <header class="page-hero">
    <p class="eyebrow">Shop with purpose</p>
    <h1 class="page-title">{{ collection.title | escape }}</h1>
    {% if collection.description != blank %}<div class="rte page-copy">{{ collection.description }}</div>{% endif %}
  </header>
  {% paginate collection.products by 24 %}
    {% if collection.products_count > 0 %}
      <div class="catalog-grid">
        {% for product in collection.products %}
          <article class="catalog-card">
            <a class="catalog-card__image" href="{{ product.url }}">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', alt: product.featured_image.alt | default: product.title }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </a>
            <div class="catalog-card__body">
              <div class="catalog-card__meta">{{ product.type | default: 'Lavish808 merchandise' }}</div>
              <h2><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
              <div class="price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</div>
            </div>
          </article>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}
    {% else %}
      <div class="empty-state"><h2>New merchandise is on the way.</h2><p class="rte">We are preparing this collection with care. Please check back soon or explore another part of the rescue story.</p><a class="button" href="{{ routes.root_url }}#shop">Explore the shop</a></div>
    {% endif %}
  {% endpaginate %}
</section>
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
